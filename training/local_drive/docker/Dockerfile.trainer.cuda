# Optional CUDA build recipe. GPU training has NOT been accepted yet.
ARG BASE_IMAGE=python:3.11.16-slim-trixie
FROM ${BASE_IMAGE}
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLCONFIGDIR=/tmp/matplotlib XDG_CACHE_HOME=/tmp/cache
WORKDIR /opt/robot-training
# cu126 retains compatibility with the local GTX 1650 generation; verify your target GPU.
RUN python -m pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cu126
COPY provenance/trainer-requirements.lock /tmp/cpu.lock
# Reuse accepted non-torch pins without accidentally reinstalling the CPU torch wheel.
RUN sed '/^torch==/d' /tmp/cpu.lock > /tmp/common.lock \
    && python -m pip install -r /tmp/common.lock \
    && python -m pip check \
    && python -m pip freeze > /opt/robot-training/cuda-requirements.resolved.txt
COPY training/ training/
COPY tests/ tests/
ENTRYPOINT ["python", "-m", "training.train"]
