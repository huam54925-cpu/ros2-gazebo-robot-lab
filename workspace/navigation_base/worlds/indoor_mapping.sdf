      <link name="structure">
        <collision name="long_collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry>
            <box>
              <size>3 1 1.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="long_visual">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry>
            <box>
              <size>3 1 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.25 0.35 1</ambient>
            <diffuse>0.7 0.25 0.35 1</diffuse>
