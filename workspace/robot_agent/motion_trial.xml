<root BTCPP_format="4" main_tree_to_execute="MotionTrial">
  <BehaviorTree ID="MotionTrial">
    <Sequence>
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker" error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}"/>
    </Sequence>
  </BehaviorTree>
</root>
